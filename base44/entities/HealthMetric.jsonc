{
  "name": "HealthMetric",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "weight_kg": {
      "type": "number"
    },
    "blood_pressure_systolic": {
      "type": "number"
    },
    "blood_pressure_diastolic": {
      "type": "number"
    },
    "heart_rate": {
      "type": "number"
    },
    "sleep_hours": {
      "type": "number"
    },
    "mood": {
      "type": "string",
      "enum": [
        "Great",
        "Good",
        "Okay",
        "Low",
        "Poor"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "date"
  ]
}